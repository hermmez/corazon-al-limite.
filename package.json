{
  "name": "corazon-al-limite",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "build": "remotion compositions src/index.ts",
    "render": "remotion render src/index.ts CorazonAlLimite out/corazon-al-limite.mp4",
    "typecheck": "tsc --noEmit",
    "validate:prueba2d": "node scripts/validar-prueba2d.mjs",
    "render:prueba2d": "remotion render src/index.ts Prueba2D out/prueba2d.mp4 --codec=h264 --pixel-format=yuv420p --crf=20",
    "validate:demo": "node scripts/validar-demo-profesional.mjs",
    "render:demo": "remotion render src/index.ts DemoProfesional2D out/demo-profesional-2d.mp4 --codec=h264 --pixel-format=yuv420p --crf=18",
    "validate:fluida": "node scripts/validar-demo-fluida.mjs",
    "render:fluida": "remotion render src/index.ts DemoProfesional2DFluida out/demo-profesional-2d-fluida.mp4 --codec=h264 --pixel-format=yuv420p --crf=18",
    "validate:sueno": "node scripts/validar-primer-video-sueno.mjs",
    "script:sueno": "node scripts/exportar-guion-sueno.mjs",
    "render:sueno": "remotion render src/index.ts PrimerVideoSueno out/primer-video-sueno.mp4 --codec=h264 --pixel-format=yuv420p --crf=20",
    "captions:sueno": "node scripts/temporizar-sueno.mjs",
    "voz:voces": "node scripts/listar-voces.mjs",
    "voz:prueba": "node scripts/generar-narracion.mjs --mode prueba",
    "voz:episodio": "node scripts/generar-narracion.mjs --mode episodio",
    "test:voz": "node --test tests/voz.test.mjs",
    "render:voz:prueba": "npm run voz:validar && remotion render src/index.ts PruebaVozElevenLabs out/elevenlabs-voz-prueba.mp4 --codec=h264 --pixel-format=yuv420p --crf=24 --scale=0.6666666667 --concurrency=2",
    "voz:validar": "node scripts/verificar-narracion.mjs",
    "render:piloto10s": "node scripts/piloto10s/render.mjs",
    "validate:piloto10s": "node scripts/piloto10s/validar.mjs",
    "render:episodio01": "node scripts/episodio-01-cerebro/render.mjs",
    "validate:episodio01": "node scripts/episodio-01-cerebro/validar.mjs",
    "playback:episodio01": "node scripts/episodio-01-cerebro/comprobar_navegador.mjs",
    "render:episodio01:ritmo": "node scripts/episodio-01-cerebro-125/render.mjs",
    "preview:episodio01:ritmo": "node scripts/episodio-01-cerebro-125/render.mjs --preview",
    "validate:episodio01:ritmo": "node scripts/episodio-01-cerebro-125/validar.mjs",
    "validate:preview:ritmo": "node scripts/episodio-01-cerebro-125/validar.mjs --preview",
    "render:episodio02": "node scripts/episodio-02-tiempo/render.mjs",
    "validate:episodio02": "node scripts/episodio-02-tiempo/validar.mjs",
    "playback:episodio02": "node scripts/episodio-02-tiempo/comprobar_navegador.mjs",
    "retention:episodio02": "python scripts/episodio-02-tiempo/analizar_retencion.py"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "2.75.0",
    "@remotion/captions": "4.0.539",
    "@remotion/cli": "^4.0.0",
    "@remotion/media": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "typescript": "^5.4.0"
  }
}
